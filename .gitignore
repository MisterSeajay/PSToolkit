###############################################################################
# Project ignores
###############################################################################

.git-rewrite
.remove-git-identity.toml

###############################################################################
# OS, secrets & temporaries
###############################################################################

# OS files
.DS_Store
*.lnk
*~
$RECYCLE.BIN/
desktop.ini
Desktop.ini
ehthumbs.db
Thumbs.db

# Secrets
.env
.env.*
!.env.example
*.crt
*.csr
*.key
*credentials*.json

# Logs and temporaries
*.log
*.raw.*
tmp/
temp/
logs/
*.tmp
*_tmp.*
*.*_20??-??-??
*.orig
nohup.out

# Local-only files
*.local*
local/

###############################################################################
# IDE, editors & AI agents
###############################################################################

.idea/
.vscode/.ropeproject/
.vscode/*.log
.vscode/ipch/
*.code-workspace
*.DotSettings.user
*.sln.docstates
*.suo
*.swo
*.swp
*.user
*.userosscache
*~

# AI coding agents
.claude/scheduled_tasks.lock
.claude/worktrees/
.aider*
.orphaned_at

################################################################################
# Transitive dependency and tool state
################################################################################

node_modules/
# A locally installed markdownlint-cli2 leaves these behind; the linter itself
# is expected on PATH, not vendored.
.markdownlint-cli2cache
.cache/
.vagrant/

################################################################################
# PowerShell
################################################################################

# Build and packaging output
# Build-Module.ps1 requires an explicit -OutputPath, but these are the
# conventional landing spots when a developer points it inside the clone.
Output/
output/
dist/
build/
artifacts/
*.nupkg
*.zip

# TestsResults.xml is the Pester default; the others are common CI names.
TestResults.xml
test-results.xml
*.trx
coverage.xml
coverage.json
coverage/
.clover.xml
