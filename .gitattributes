# Line endings: store LF in the repository, check out CRLF in the working tree.
# Without this, line endings depend on each contributor's core.autocrlf setting.
* text=auto eol=crlf

# PowerShell sources are UTF-8 *with* a byte-order mark.
# Windows PowerShell 5.1 reads BOM-less files as ANSI/Windows-1252, so without a
# BOM any non-ASCII character (see Public/Format-Tree.ps1) renders as mojibake.
# The BOM is committed here rather than produced by working-tree-encoding, which
# Git documents as not recommended and which complicates renormalisation.
*.ps1  text
*.psd1 text
*.psm1 text

# Git hooks are interpreted by sh, and the shebang is the first line. A CR
# before the LF makes it "#!/bin/sh^M", which sh cannot find, so the hook fails
# on every commit or is silently skipped. LF is not negotiable here.
.githooks/* text eol=lf
